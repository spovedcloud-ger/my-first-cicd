        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "rate(database_query_duration_seconds_count[5m])",
          "legendFormat": "DB Queries",
          "refId": "A"

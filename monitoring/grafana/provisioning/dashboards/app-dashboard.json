          "expr": "rate(redis_operation_duration_seconds_count{operation=\"get\",status=\"hit\"}[5m]) / rate(redis_operation_duration_seconds_count{operation=\"get\"}[5m]) * 100",
          "refId": "A"
        }
      ],
      "title": "Cache Hit Rate",
      "type": "gauge"

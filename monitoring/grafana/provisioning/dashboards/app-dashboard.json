        {
          "expr": "rate(redis_operation_duration_seconds_count[5m])",
          "legendFormat": "Redis Ops",
          "refId": "B"
        }
      ],
      "title": "Database & Redis Operations",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
